# Redirector v3 API image (dev dual-serve, EPIC-08 M1).
#
# The production image shape (multi-stage, non-root, single all-in-one)
# lands with EPIC-07/08 M3 — this file exists so the M1 harness can boot
# the real FastAPI app next to the v2 Flask container today.
# Build context is the repo root (see docker/compose.m1.yml).

FROM python:3.13-slim

WORKDIR /app
ENV PYTHONUNBUFFERED=1 \
    REDIRECTOR_DATA_DIR=/app/data

COPY backend/requirements.txt ./backend-requirements.txt
RUN pip install --no-cache-dir -r backend-requirements.txt

COPY backend ./backend
COPY VERSION ./VERSION

RUN mkdir -p /app/data

EXPOSE 8123

HEALTHCHECK --interval=15s --timeout=5s --start-period=10s --retries=3 \
    CMD python -c "import urllib.request,sys; sys.exit(0 if urllib.request.urlopen('http://localhost:8123/healthz', timeout=3).status==200 else 1)"

CMD ["python", "-m", "uvicorn", "backend.main:app", "--host", "0.0.0.0", "--port", "8123"]
