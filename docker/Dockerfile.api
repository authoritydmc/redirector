# Redirector v3 API image (EPIC-07 task 5 / EPIC-08 M3 shape).
#
# Layout: /app holds code (replaced on upgrade), /app/data holds all state
# (bind-mounted, survives upgrades) — same contract as the v2 image.
# Runs as non-root; migrates on boot (alembic upgrade head) like the v2
# entrypoint runs `flask db upgrade`.
# Build context is the repo root:  docker build -f docker/Dockerfile.api .

FROM python:3.13-slim AS base

WORKDIR /app
ENV PYTHONUNBUFFERED=1 \
    REDIRECTOR_DATA_DIR=/app/data

COPY backend/requirements.txt ./backend-requirements.txt
RUN pip install --no-cache-dir -r backend-requirements.txt \
    && rm backend-requirements.txt

COPY backend ./backend
COPY VERSION ./VERSION
COPY docker/api-entrypoint.sh ./docker-entrypoint.sh
RUN chmod +x ./docker-entrypoint.sh && mkdir -p /app/data

RUN useradd --create-home --shell /usr/sbin/nologin appuser \
    && chown -R appuser:appuser /app
USER appuser

EXPOSE 8123

HEALTHCHECK --interval=15s --timeout=5s --start-period=20s --retries=3 \
    CMD python -c "import urllib.request,sys; sys.exit(0 if urllib.request.urlopen('http://localhost:8123/healthz', timeout=3).status==200 else 1)"

ENTRYPOINT ["./docker-entrypoint.sh"]
# Explicit event loop + HTTP parser (uvicorn[standard] would pick these on
# Linux anyway; pinned so behavior never depends on installer extras).
# Single worker by design — scale with `docker compose up --scale api=N`
# on the postgres overlay, not with --workers (see docker/README.md).
CMD ["python", "-m", "uvicorn", "backend.main:app", "--host", "0.0.0.0", "--port", "8123", "--loop", "uvloop", "--http", "httptools"]
