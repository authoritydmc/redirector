    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "openapi-typescript": "^7.0.0",
    "tailwindcss": "^4.0.0",
    "typescript": "~5.7.0",
    "vite": "^6.0.0",
    "vitest": "^3.0.0"
  }
}
